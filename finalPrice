import java.util.*;

class Result {

    public static void finalPrice(List<Integer> prices) {

        int n = prices.size();

        int[] finalPrices = new int[n];

        Deque<Integer> stack = new ArrayDeque<>();

        // Calculate discounted prices
        for (int i = n - 1; i >= 0; i--) {

            int current = prices.get(i);

            while (!stack.isEmpty() && prices.get(stack.peek()) > current) {
                stack.pop();
            }

            if (stack.isEmpty()) {
                finalPrices[i] = current;
            } else {
                finalPrices[i] = current - prices.get(stack.peek());
            }

            stack.push(i);
        }

        long total = 0;

        for (int price : finalPrices) {
            total += price;
        }

        System.out.println(total);

        boolean first = true;

        for (int i = 0; i < n; i++) {

            if (finalPrices[i] == prices.get(i)) {

                if (!first) {
                    System.out.print(" ");
                }

                System.out.print(i);

                first = false;
            }
        }

        System.out.println();
    }
}
